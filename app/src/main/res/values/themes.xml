<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Ticket #24 — system SplashScreen theme.
         Colors are fully controlled by Compose WordDrillTheme; this theme only sets
         transparent system bars (edge-to-edge) and a transparent window background
         to avoid white flashes.

         Key: postSplashScreenTheme points at this theme itself (the base application theme);
         installSplashScreen() is called before super.onCreate; the system switches back to
         this theme once the splash ends. -->
    <style name="Theme.WordDrill" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>

    <!-- Ticket #24 — splash screen theme (forced by the system on API 31+).
         parent must be Theme.SplashScreen and postSplashScreenTheme must point at the real theme.
         windowSplashScreenBackground = the app's main background color (seamless handoff);
         windowSplashScreenAnimatedIcon = a transparent drawable (same color as the background,
         so no system logo is visible) — the custom Compose launch animation is the only
         animation the user sees, from the first frame.
         android:windowBackground is also set to that color, preventing the compat library
         parent's default gradient from leaking through. -->
    <style name="Theme.WordDrill.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_invisible</item>
        <item name="android:windowBackground">@color/ic_launcher_background</item>
        <item name="postSplashScreenTheme">@style/Theme.WordDrill</item>
    </style>
</resources>
