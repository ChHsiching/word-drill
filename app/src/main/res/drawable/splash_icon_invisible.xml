<?xml version="1.0" encoding="utf-8"?>
<!-- Ticket #24 — placeholder icon for the system splash screen: a 1×1px transparent VectorDrawable.
     windowSplashScreenAnimatedIcon must point at a drawable (the system rejects null);
     fully transparent, the system splash is visually just the background color
     (ic_launcher_background), so the custom Compose animation owns every frame and the
     "big logo first, then animation" effect is gone. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="1dp"
    android:height="1dp"
    android:viewportWidth="1"
    android:viewportHeight="1">
    <path
        android:pathData="M0,0 L1,0 L1,1 L0,1 Z"
        android:fillColor="#00000000" />
</vector>
