        <path
            android:pathData="M38,28 L58,28"
            android:strokeColor="#FAFAFA"
            android:strokeWidth="4"
            android:strokeLineCap="round" />
        <path
            android:pathData="M38,38 L52,38"
            android:strokeColor="#FAFAFA"
            android:strokeWidth="4"
            android:strokeLineCap="round" />
        <path
            android:pathData="M38,48 L55,48"
            android:strokeColor="#FAFAFA"
            android:strokeWidth="4"
            android:strokeLineCap="round" />
    </group>
</vector>
