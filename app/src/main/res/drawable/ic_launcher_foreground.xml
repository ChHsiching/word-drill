<!-- Ticket #24 — overlapping-cards icon foreground (design B: solid front card, outlined rear card).
     Design source: designs/worddrill-icon/icon-03-compare.html option B, viewBox 0 0 80 80.
     The foreground viewport is 108×108; the 80×80 design content is mapped into the centered
     66×66 safe zone via group scale=0.825 + translate ((0,0)→(21,21), (80,80)→(87,87), centered at 54,54).
     Light-background variant: lines/blocks use #1A1A1A, text lines on the front card use #FAFAFA. Dark variant in drawable-night. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="0.7"
        android:scaleY="0.7"
        android:translateX="26"
        android:translateY="22">
        <!-- Rear card outline: rect 14,22 37×50 rx=6, converted to a rounded-rect path -->
        <path
            android:pathData="M20,22 L45,22 A6,6 0 0 1 51,28 L51,72 A6,6 0 0 1 45,78 L20,78 A6,6 0 0 1 14,72 L14,28 A6,6 0 0 1 20,22 Z"
            android:strokeColor="#1A1A1A"
            android:strokeWidth="5"
            android:fillColor="#00000000" />
        <!-- Front card solid fill: rect 29,14 37×50 rx=6 -->
        <path
            android:pathData="M35,14 L60,14 A6,6 0 0 1 66,20 L66,64 A6,6 0 0 1 60,70 L35,70 A6,6 0 0 1 29,64 L29,20 A6,6 0 0 1 35,14 Z"
            android:fillColor="#1A1A1A" />
